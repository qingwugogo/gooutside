.page {
    min-height: 100vh;
    padding: 24rpx;
    box-sizing: border-box;
}

.login-wrap {
    padding: 40rpx 0;
}

.form-card {
    padding: 28rpx;
}

.required {
    color: #D64541;
}

/* 位置 */
.loc-btn {
    background: #E9F2ED;
    color: #2E7D5B;
    border-radius: 14rpx;
    padding: 26rpx 24rpx;
    font-size: 28rpx;
    text-align: center;
}

.loc-result {
    display: flex;
    align-items: center;
    background: #E9F2ED;
    border-radius: 14rpx;
    padding: 20rpx 24rpx;
}

.loc-text-wrap {
    flex: 1;
    min-width: 0;
}

.loc-name {
    display: block;
    font-size: 28rpx;
    color: #22262B;
    font-weight: 600;
}

.loc-addr {
    display: block;
    font-size: 22rpx;
    color: #8a8f99;
    margin-top: 6rpx;
}

.loc-clear {
    flex-shrink: 0;
    margin-left: 16rpx;
    font-size: 24rpx;
    color: #2E7D5B;
}

/* 标签 */
.tag-wrap {
    display: flex;
    flex-wrap: wrap;
}

.tag-select {
    font-size: 24rpx;
    color: #4b5158;
    background: #ffffff;
    border: 2rpx solid #E7EAE6;
    border-radius: 999rpx;
    padding: 10rpx 26rpx;
    margin: 0 16rpx 16rpx 0;
}

.tag-on {
    color: #ffffff;
    background: #2E7D5B;
    border-color: #2E7D5B;
}

/* 照片 */
.photo-row {
    display: flex;
    flex-wrap: wrap;
}

.photo-box {
    position: relative;
    width: 150rpx;
    height: 150rpx;
    margin: 0 16rpx 16rpx 0;
}

.photo-img {
    width: 100%;
    height: 100%;
    border-radius: 12rpx;
    background: #EDF1EE;
}

.photo-del {
    position: absolute;
    top: -14rpx;
    right: -14rpx;
    width: 40rpx;
    height: 40rpx;
    border-radius: 50%;
    background: rgba(34, 38, 43, 0.7);
    color: #ffffff;
    font-size: 30rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

.photo-add {
    width: 150rpx;
    height: 150rpx;
    border: 2rpx dashed #C6CCC6;
    border-radius: 12rpx;
    color: #8a8f99;
    font-size: 56rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

.placeholder {
    color: #b3b8bf;
}

.submit-btn {
    margin-top: 32rpx;
}
