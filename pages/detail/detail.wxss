.page {
    display: flex;
    flex-direction: column;
    height: 100vh;
}

.detail-scroll {
    flex: 1;
    min-height: 0;
    height: 0;
    padding: 24rpx;
    box-sizing: border-box;
}

.section {
    padding: 28rpx;
    margin-bottom: 24rpx;
}

.head-row {
    display: flex;
    align-items: center;
}

.name {
    font-size: 38rpx;
    font-weight: 700;
    color: #22262B;
    flex: 1;
}

.free-badge {
    flex-shrink: 0;
    font-size: 22rpx;
    color: #2E7D5B;
    background: #E9F2ED;
    border: 2rpx solid #BFDCCD;
    border-radius: 8rpx;
    padding: 4rpx 14rpx;
}

.rating-row {
    display: flex;
    align-items: baseline;
    margin-top: 14rpx;
}

.stars-big {
    font-size: 32rpx;
}

.rating-num {
    margin-left: 12rpx;
    font-size: 30rpx;
    font-weight: 700;
    color: #F5A93F;
}

.rating-count {
    margin-left: 12rpx;
    font-size: 24rpx;
    color: #8a8f99;
}

.address {
    display: block;
    margin-top: 16rpx;
    font-size: 24rpx;
    color: #8a8f99;
    line-height: 1.6;
}

.tags {
    display: flex;
    flex-wrap: wrap;
    margin-top: 16rpx;
}

.tag {
    font-size: 22rpx;
    color: #2E7D5B;
    background: #E9F2ED;
    border-radius: 8rpx;
    padding: 6rpx 16rpx;
    margin: 0 12rpx 12rpx 0;
}

.desc {
    display: block;
    margin-top: 8rpx;
    font-size: 26rpx;
    color: #4b5158;
    line-height: 1.7;
}

.section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 20rpx;
}

.section-title {
    font-size: 30rpx;
    font-weight: 700;
    color: #22262B;
}

.section-sub {
    font-size: 24rpx;
    color: #8a8f99;
}

/* ===== 照片 ===== */
.photo-grid {
    display: flex;
    flex-wrap: wrap;
}

.photo-cell {
    width: 210rpx;
    height: 210rpx;
    border-radius: 12rpx;
    margin: 0 12rpx 12rpx 0;
    background: #EDF1EE;
}

.photo-lock {
    text-align: center;
    padding: 24rpx 0;
}

.photo-lock-text {
    display: block;
    font-size: 26rpx;
    color: #8a8f99;
    margin-bottom: 20rpx;
}

.photo-lock-btn {
    display: inline-block;
    padding: 12rpx 48rpx;
    border-radius: 999rpx;
    background: #2E7D5B;
    color: #ffffff;
    font-size: 26rpx;
}

/* ===== 评价 ===== */
.review-empty {
    text-align: center;
    color: #8a8f99;
    font-size: 26rpx;
    padding: 24rpx 0;
}

.review-item {
    padding: 20rpx 0;
    border-top: 2rpx solid #F0F2EF;
}

.review-item:first-of-type {
    border-top: none;
}

.review-top {
    display: flex;
    align-items: center;
}

.avatar {
    width: 64rpx;
    height: 64rpx;
    border-radius: 50%;
    background: #E9F2ED;
    color: #2E7D5B;
    font-size: 28rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.review-meta {
    flex: 1;
    min-width: 0;
    margin-left: 16rpx;
}

.review-name {
    display: block;
    font-size: 26rpx;
    color: #22262B;
    font-weight: 600;
}

.review-date {
    display: block;
    font-size: 22rpx;
    color: #b3b8bf;
    margin-top: 4rpx;
}

.review-content {
    display: block;
    margin-top: 14rpx;
    font-size: 27rpx;
    color: #4b5158;
    line-height: 1.7;
}

.review-grid .photo-cell {
    width: 160rpx;
    height: 160rpx;
}

/* ===== 底部操作（导航为主按钮） ===== */
.action-bar {
    display: flex;
    align-items: center;
    padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
    background: #ffffff;
    box-shadow: 0 -4rpx 16rpx rgba(34, 38, 43, 0.06);
}

/* 统一重置微信 button 默认样式（含 ::after 幽灵边框） */
.action-btn,
.action-icon {
    box-sizing: border-box;
    height: 92rpx;
    padding: 0;
    margin: 0;
    border-radius: 999rpx;
    font-size: 31rpx;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
}

.action-btn::after,
.action-icon::after {
    border: none;
}

/* 写评价：白底绿描边（次要） */
.action-review {
    flex: 1 1 0;
    min-width: 0;
    margin-right: 18rpx;
    background: #ffffff;
    color: #2E7D5B;
    border: 2rpx solid #BFD8CC;
    line-height: 88rpx;
}

/* 导航：实心渐变主按钮，参考高德「去这里」 */
.action-nav {
    flex: 1.15 1 0;
    min-width: 0;
    margin-right: 18rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    background: linear-gradient(135deg, #2E9E6B, #227654);
    color: #ffffff;
    border: none;
    box-shadow: 0 6rpx 18rpx rgba(34, 118, 84, 0.35);
    font-weight: 600;
    letter-spacing: 2rpx;
}

.nav-ico {
    font-size: 26rpx;
    margin-right: 10rpx;
    transform: rotate(-90deg);
    line-height: 1;
}

/* 分享：圆形图标按钮 */
.action-icon {
    flex: 0 0 92rpx;
    width: 92rpx;
    border-radius: 50%;
    background: #F1F5F2;
    color: #2E7D5B;
    border: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1.1;
}

.share-ico {
    font-size: 34rpx;
    line-height: 1;
}

.share-label {
    font-size: 18rpx;
    line-height: 1.2;
    margin-top: 2rpx;
    color: #5f6f66;
}

/* 地址行可点击导航 */
.address-nav {
    display: block;
}

.nav-hint {
    color: #2E7D5B;
    font-size: 22rpx;
    margin-left: 8rpx;
}

.bottom-space {
    height: 40rpx;
}

/* 更多操作（举报 / 删除） */
.more-btn {
    flex-shrink: 0;
    margin-left: 12rpx;
    padding: 4rpx 12rpx;
    font-size: 30rpx;
    line-height: 1;
    color: #A6ADB6;
    letter-spacing: 1rpx;
}

.review-more {
    margin-left: 8rpx;
    font-size: 28rpx;
}
