.page {
    min-height: 100vh;
    padding: 24rpx;
    box-sizing: border-box;
}

.login-wrap {
    padding: 40rpx 0;
}

.form-card {
    padding: 28rpx;
}

.target {
    display: flex;
    align-items: baseline;
    padding-bottom: 20rpx;
    margin-bottom: 28rpx;
    border-bottom: 2rpx solid #F0F2EF;
}

.target-label {
    font-size: 24rpx;
    color: #8a8f99;
    margin-right: 16rpx;
}

.target-name {
    font-size: 30rpx;
    font-weight: 700;
    color: #22262B;
    flex: 1;
}

/* 星级 */
.rate-row {
    display: flex;
}

.rate-star {
    font-size: 64rpx;
    color: #E0E4DF;
    margin-right: 16rpx;
    line-height: 1;
}

.rate-star-on {
    color: #F5A93F;
}

.rate-text {
    display: block;
    margin-top: 10rpx;
    font-size: 26rpx;
    color: #F5A93F;
    font-weight: 600;
}

/* 照片 */
.photo-row {
    display: flex;
    flex-wrap: wrap;
}

.photo-box {
    position: relative;
    width: 150rpx;
    height: 150rpx;
    margin: 0 16rpx 16rpx 0;
}

.photo-img {
    width: 100%;
    height: 100%;
    border-radius: 12rpx;
    background: #EDF1EE;
}

.photo-del {
    position: absolute;
    top: -14rpx;
    right: -14rpx;
    width: 40rpx;
    height: 40rpx;
    border-radius: 50%;
    background: rgba(34, 38, 43, 0.7);
    color: #ffffff;
    font-size: 30rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

.photo-add {
    width: 150rpx;
    height: 150rpx;
    border: 2rpx dashed #C6CCC6;
    border-radius: 12rpx;
    color: #8a8f99;
    font-size: 56rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

.placeholder {
    color: #b3b8bf;
}

.submit-btn {
    margin-top: 32rpx;
}
